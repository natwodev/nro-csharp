  "id": null, // PK AUTO_INCREMENT (null trước khi INSERT) | C#: Player.Id [dùng]
  "account_id": null, // FK account.id (UNIQUE: 1 tài khoản 1 nhân vật); = userId khi tạo | C#: Player.Account_id [dùng]
  "name": null, // tên nhân vật (người chơi nhập, varchar 20) | C#: Player.Name [dùng]
  "head": null, // part đầu = kiểu tóc client gửi khi tạo (DEFAULT 102 không dùng vì INSERT luôn ghi); load: -1 → 64 (TĐ) | C#: Player.Head [dùng]
  "gender": 0, // hành tinh 0 TĐ / 1 Namếc / 2 Xayda | C#: Player.Gender [dùng]
  "have_tennis_space_ship": 0, // có tàu Tennis (tinyint 0/1) | C#: Player.HaveTennisSpaceShip [dùng]
